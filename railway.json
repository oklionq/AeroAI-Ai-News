{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "python -u -m bot.main",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "limitOverride": {
      "containers": {
        "cpu": 1.0,
        "memoryBytes": 1073741824
      }
    }
  }
}
